// Y[t][:] = X[x_row0 + t][:] * rsqrt(mean(X^2) + eps) * W[:], one workgroup
// per token; with add, Y[t][:] += that (Gemma's norms after attention and
// the FFN, into the residual), and the result is times mul (Gemma 4's
// layer_output_scale on the residual after its FFN; 1 elsewhere). Each
// thread keeps its first NPT values in registers for the store; rows wider
// than WG * NPT loop for the rest. The compiler (ACO) waits for those loads
// one at a time and for the weights after the barrier, 15 memory round trips
// one after another for a row of 4,096 on the PS5's GPU: rmsnorm_early.comp,
// Linux's default, issues them all before the first wait.
#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#define WG 512
#define NPT 8
layout(local_size_x = WG) in;
layout(std430, binding = 0) readonly buffer Xbuf { float X[]; };
layout(std430, binding = 1) readonly buffer Wbuf { float W[]; };
layout(std430, binding = 2) buffer Ybuf { float Y[]; };
layout(push_constant) uniform PC { uint n, x_row0; float eps; uint add; float mul; } pc;
shared float red[WG / 4];  // one per subgroup (4 lanes or more)

void main() {
    const uint t = gl_WorkGroupID.x, tid = gl_LocalInvocationID.x;
    const uint xb = (pc.x_row0 + t) * pc.n, yb = t * pc.n;
    float v[NPT];
    float s = 0.0;
    for (uint k = 0; k < NPT; k++) {
        const uint i = tid + k * WG;
        v[k] = i < pc.n ? X[xb + i] : 0.0;
        s += v[k] * v[k];
    }
    for (uint i = tid + NPT * WG; i < pc.n; i += WG) s += X[xb + i] * X[xb + i];
    s = subgroupAdd(s);
    if (gl_SubgroupInvocationID == 0) red[gl_SubgroupID] = s;
    barrier();
    float total = 0.0;
    for (uint i = 0; i < gl_NumSubgroups; i++) total += red[i];
    const float scale = inversesqrt(total / float(pc.n) + pc.eps);
    for (uint k = 0; k < NPT; k++) {
        const uint i = tid + k * WG;
        if (i < pc.n) Y[yb + i] = (v[k] * scale * W[i] + (pc.add != 0 ? Y[yb + i] : 0.0)) * pc.mul;
    }
    for (uint i = tid + NPT * WG; i < pc.n; i += WG)
        Y[yb + i] = (X[xb + i] * scale * W[i] + (pc.add != 0 ? Y[yb + i] : 0.0)) * pc.mul;
}
