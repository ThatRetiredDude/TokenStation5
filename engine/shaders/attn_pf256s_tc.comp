#version 450
#extension GL_GOOGLE_include_directive : require
// attn_pf256s_t with subgroupClusteredAdd kept (TS5_ATTN_PF_TRIM=2, the tests on
// lavapipe; see attn_pf.glsl).
// attn_pf256 in tiles of 16 keys: 128 registers a thread on the PS5 (gfx1013,
// wave64 or 32) instead of 168, so a compute unit holds two workgroups instead of
// one. Keys are scored 16 at a time either way, so the output is the same.
#define HEAD_DIM 256
#define LANES 8
#define KEYS 16
#define PF_TRIM
#define PF_CLUSTER_ADD
#include "attn_pf.glsl"
