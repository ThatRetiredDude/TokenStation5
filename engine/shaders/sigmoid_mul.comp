// X *= sigmoid(G) over n values (Qwen 3.5's gate on attention's output).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Xbuf { float X[]; };
layout(std430, binding = 1) readonly buffer Gbuf { float G[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256)
        X[i] /= 1.0 + exp(-G[i]);
}
