#version 450
#extension GL_GOOGLE_include_directive : require
// y[r] (+)= sum_c W[r][c] * x[c] for one token of a Q2_0 matrix (two bits a
// weight, as the Bonsai files: a block is 18 bytes for 64 values, d as f16,
// then 16 bytes with value c in bits 2 (c % 4) and up of byte c / 4, and a
// value is (q - 1) d). Laid out as mv16_q5_0: each of the workgroup's 64
// threads takes one block of a row at a time, blocks tid, tid + 64, ..., for
// NR rows (a specialization constant, at most 8), and loads its 64 values of
// x once for all NR rows. sum (q - 1) x = sum q x - sum x, so the block's sum
// of x is taken once for all rows too. Blocks are only 2-byte aligned: a
// block is read as five 4-byte words from its byte o's word.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

#define WG 64
#define NRMAX 8
layout(local_size_x = WG) in;
layout(constant_id = 0) const uint NR = 1;  // rows per workgroup, at most NRMAX

layout(std430, binding = 0) readonly buffer W32 { uint w32[]; };
layout(std430, binding = 1) readonly buffer Xbuf { vec4 X4[]; };
layout(std430, binding = 2) buffer Ybuf { float Y[]; };

layout(push_constant) uniform PC {
    uint ncols, nrows, ntok, row_bytes;
    uint x_stride, y_stride, accumulate, x_off;
} pc;

shared float partial[NRMAX * WG];  // [row][subgroup]

// The block at byte o (2-byte aligned) dotted with x (x[c]: values 4c ..
// 4c + 3; xs: their sum). The last word is only needed for its low half
// where the block starts a word, which may be the two bytes past the block:
// clamped to the buffer.
float block_dot(uint o, vec4 x[16], float xs) {
    const uint i = o >> 2, sh = (o & 2u) * 8u;
    uint w[5];
    [[unroll]] for (uint k = 0; k < 4; k++) w[k] = w32[i + k];
    w[4] = w32[min(i + 4, w32.length() - 1)];
    const float d = unpackHalf2x16(w[0] >> sh).x;
    float s = 0.0;
    [[unroll]] for (uint k = 0; k < 4; k++) {
        // Bytes 4k .. 4k + 3 of the block's sixteen: values 16k .. 16k + 15.
        const uint q = sh == 0 ? (w[k] >> 16) | (w[k + 1] << 16) : w[k + 1];
        [[unroll]] for (uint b = 0; b < 4; b++) {
            const uvec4 v = (uvec4(q >> (8 * b)) >> uvec4(0, 2, 4, 6)) & 3u;
            s += dot(vec4(v), x[4 * k + b]);
        }
    }
    return d * (s - xs);
}

void main() {
    const uint r0 = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * NR;
    if (r0 >= pc.nrows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint nblk = pc.ncols / 64, nr = min(NR, pc.nrows - r0);
    float acc[NRMAX];
    for (uint i = 0; i < NRMAX; i++) acc[i] = 0.0;
    for (uint j = tid; j < nblk; j += WG) {
        const uint x0 = (pc.x_off + j * 64) / 4;
        vec4 x[16];
        vec4 sum = vec4(0.0);
        for (uint c = 0; c < 16; c++) {
            x[c] = X4[x0 + c];
            sum += x[c];
        }
        const float xs = sum.x + sum.y + sum.z + sum.w;
        // Rows past the matrix read its last row; their sums aren't written.
        [[unroll]] for (uint i = 0; i < NR; i++)
            acc[i] += block_dot(min(r0 + i, pc.nrows - 1) * pc.row_bytes + j * 18, x, xs);
    }
    for (uint i = 0; i < NR; i++) {
        const float s = subgroupAdd(acc[i]);
        if (gl_SubgroupInvocationID == 0) partial[i * WG + gl_SubgroupID] = s;
    }
    barrier();
    if (tid < nr) {
        float s = 0.0;
        for (uint i = 0; i < gl_NumSubgroups; i++) s += partial[tid * WG + i];
        const uint r = r0 + tid;
        Y[r] = pc.accumulate != 0 ? Y[r] + s : s;
    }
}
