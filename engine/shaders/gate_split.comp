// Qwen 3.5's attention layers: attn_q's output QG ([t][h][2][HD]: each
// head's queries, then its gate) into Q ([t][h][HD]) and G (the same).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer QGbuf { float QG[]; };
layout(std430, binding = 1) writeonly buffer Qbuf { float Q[]; };
layout(std430, binding = 2) writeonly buffer Gbuf { float G[]; };
layout(push_constant) uniform PC { uint n, head_dim; } pc;  // n: values of Q

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) {
        const uint th = i / pc.head_dim, d = i % pc.head_dim, src = th * 2 * pc.head_dim + d;
        Q[i] = QG[src];
        G[i] = QG[src + pc.head_dim];
    }
}
