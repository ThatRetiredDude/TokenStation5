#version 450
#extension GL_GOOGLE_include_directive : require
// attn_pf512s with PF_TRIM: unmasked whole tiles, shuffled sums, and (constant 0 = 1)
// no ring arithmetic; the same output (see attn_pf.glsl).
// attn_pf512 with no tile loaded ahead: 128 registers a thread on the PS5
// (gfx1013, wave64 or 32) instead of 168, so a compute unit holds two workgroups
// instead of one. The sums are the same, so the output too.
#define HEAD_DIM 512
#define LANES 16
#define KEYS 16
#define NO_PREFETCH
#define PF_TRIM
#include "attn_pf.glsl"
