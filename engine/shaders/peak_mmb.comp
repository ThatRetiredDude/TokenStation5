#version 450
// ts5 peak: the 128 x 128 prompt kernel's inner loop alone (matmul_big.glsl
// with MMB_F16: 8 rows x 8 tokens a thread, operands from shared memory),
// with no loads from memory, no dequantizing and no barriers in the loop:
// how fast that loop can go on this GPU.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#define SV f16vec4
#define BK 32
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Obuf { float o[]; };
layout(push_constant) uniform PC { uint n, iters, chunk; } pc;
shared SV Ws[BK][32];
shared SV Xs[BK][32];
void main() {
    const uint tid = gl_LocalInvocationID.x, tr = tid % 16, tt = tid / 16;
    for (uint i = tid; i < BK * 32; i += 256) {
        Ws[i / 32][i % 32] = SV(float16_t(0.001) * float16_t(i & 15u));
        Xs[i / 32][i % 32] = SV(float16_t(0.002) * float16_t(i & 7u));
    }
    barrier();
    vec4 acc[2][8];
    for (uint a = 0; a < 2; a++)
        for (uint j = 0; j < 8; j++) acc[a][j] = vec4(0.0);
    for (uint it = 0; it < pc.iters; it++) {
        SV s[2][8];
        for (uint a = 0; a < 2; a++)
            for (uint j = 0; j < 8; j++) s[a][j] = SV(0.0);
        for (uint k = 0; k < BK; k++) {
            const SV w0 = Ws[k][tr], w1 = Ws[k][16 + tr], x0 = Xs[k][tt], x1 = Xs[k][16 + tt];
            s[0][0] += w0 * x0.x; s[0][1] += w0 * x0.y; s[0][2] += w0 * x0.z; s[0][3] += w0 * x0.w;
            s[0][4] += w0 * x1.x; s[0][5] += w0 * x1.y; s[0][6] += w0 * x1.z; s[0][7] += w0 * x1.w;
            s[1][0] += w1 * x0.x; s[1][1] += w1 * x0.y; s[1][2] += w1 * x0.z; s[1][3] += w1 * x0.w;
            s[1][4] += w1 * x1.x; s[1][5] += w1 * x1.y; s[1][6] += w1 * x1.z; s[1][7] += w1 * x1.w;
        }
        for (uint a = 0; a < 2; a++)
            for (uint j = 0; j < 8; j++) acc[a][j] += vec4(s[a][j]);
    }
    float t = 0.0;
    for (uint a = 0; a < 2; a++)
        for (uint j = 0; j < 8; j++) t += acc[a][j].x + acc[a][j].y + acc[a][j].z + acc[a][j].w;
    if (t == -1.0) o[gl_WorkGroupID.x] = t;
}
