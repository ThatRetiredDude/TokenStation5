#version 450
// Y[t][r] (+)= sum_c W[r][c] * X[t][c] for NT tokens (a specialization
// constant, 2..8) of a Q6_K matrix: the verify batch of speculative
// decoding. Laid out as mv16_q6_k (8 threads share a 210-byte block, the
// workgroup's 64 threads take 8 blocks at a time), for NR rows (a
// specialization constant, at most 4): each row's words and scales are
// loaded once per block and dotted with every token's x, so the weight
// stream is paid once for the whole batch, and each token's 32 x values
// and their sums are loaded once per NR rows rather than once per row.
// Both loops are compile-time, so every token's loads are in flight at
// once. See mv16_q6_k.comp for the block layout.
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

#define WG 64
#define NTMAX 8
#define NRMAX 4
layout(local_size_x = WG) in;
layout(constant_id = 0) const uint NT = 2;  // tokens, at most NTMAX
layout(constant_id = 1) const uint NR = 1;  // rows per workgroup, at most NRMAX

layout(std430, binding = 0) readonly buffer W32 { uint w32[]; };
layout(std430, binding = 0) readonly buffer W16 { uint16_t w16[]; };
layout(std430, binding = 1) readonly buffer Xbuf { vec4 X4[]; };
layout(std430, binding = 2) buffer Ybuf { float Y[]; };

layout(push_constant) uniform PC {
    uint ncols, nrows, ntok, row_bytes;
    uint x_stride, y_stride, accumulate, x_off;
} pc;

shared float partial[NRMAX * NTMAX * WG];  // [row][token][subgroup]

// The 8 bytes at a 2-byte-aligned offset. The third word is read only to be
// shifted in; at most 2 bytes past the run, clamped to the buffer.
uvec2 read8(uint off) {
    const uint i = off >> 2, sh = (off & 2u) * 8u;
    const uint a = w32[i], b = w32[i + 1], c = w32[min(i + 2, w32.length() - 1)];
    return sh == 0 ? uvec2(a, b) : uvec2((a >> 16) | (b << 16), (b >> 16) | (c << 16));
}
vec4 bytes4(uint w) { return vec4(float(w & 255u), float((w >> 8) & 255u), float((w >> 16) & 255u), float(w >> 24)); }

// Thread t's share of the block at byte o, loaded once per row: its three
// 8-byte runs of ql and qh, its 4 scales and the block's d.
void load_block(uint o, uint t, out uvec2 q0, out uvec2 q1, out uvec2 qh, out vec4 s, out float d) {
    const uint h = t >> 2, l = 8 * (t & 3u);
    q0 = read8(o + 64 * h + l);
    q1 = read8(o + 64 * h + 32 + l);
    qh = read8(o + 128 + 32 * h + l);
    const uvec2 sc = read8(o + 192 + 8 * h);
    d = unpackHalf2x16(uint(w16[(o + 208) >> 1])).x;
    const int ss = int(8 * (l / 16));  // scales[8 h + 2 i + l / 16]: byte l / 16 of each pair
    s = vec4(bitfieldExtract(int(sc.x), ss, 8), bitfieldExtract(int(sc.x), 16 + ss, 8),
             bitfieldExtract(int(sc.y), ss, 8), bitfieldExtract(int(sc.y), 16 + ss, 8));
}

// Those words against one token's x (x[2 i + j]: values 32 i + l .. + 7 of
// the thread's half, 4 at a time), with xs the x sums per i.
float block_dot(uvec2 q0, uvec2 q1, uvec2 qh, vec4 s, float d, vec4 x[8], vec4 xs) {
    vec4 dots = vec4(0.0);
    [[unroll]] for (uint i = 0; i < 4; i++) {
        const uvec2 lo = (i & 1u) != 0 ? q1 : q0;
        const uint ns = 4 * (i >> 1);
        [[unroll]] for (uint j = 0; j < 2; j++) {
            const uint q = ((lo[j] >> ns) & 0x0F0F0F0Fu) | (((qh[j] >> (2 * i)) & 0x03030303u) << 4);
            dots[i] += dot(bytes4(q), x[2 * i + j]);
        }
    }
    return d * dot(s, dots - 32.0 * xs);
}

void main() {
    const uint r0 = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * NR;
    if (r0 >= pc.nrows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint nb = pc.ncols / 256;
    const uint t = tid % 8, h = t >> 2, l = 8 * (t & 3u);
    float acc[NRMAX * NTMAX];
    for (uint i = 0; i < NRMAX * NTMAX; i++) acc[i] = 0.0;
    for (uint b = tid / 8; b < nb; b += WG / 8) {
        // The NR rows' words, all in flight at once. Rows past the matrix
        // read its last row; their sums aren't written.
        uvec2 q0[NRMAX], q1[NRMAX], qh[NRMAX];
        vec4 s[NRMAX];
        float d[NRMAX];
        [[unroll]] for (uint i = 0; i < NR; i++)
            load_block(min(r0 + i, pc.nrows - 1) * pc.row_bytes + b * 210, t, q0[i], q1[i], qh[i], s[i], d[i]);
        const uint xb0 = b * 256 + 128 * h + l;
        [[unroll]] for (uint tk = 0; tk < NT; tk++) {
            const uint xb = (pc.x_off + tk * pc.x_stride + xb0) / 4;
            vec4 x[8];
            vec4 xs;
            for (uint i = 0; i < 4; i++) {
                x[2 * i] = X4[xb + 8 * i];
                x[2 * i + 1] = X4[xb + 8 * i + 1];
                xs[i] = dot(x[2 * i] + x[2 * i + 1], vec4(1.0));
            }
            [[unroll]] for (uint i = 0; i < NR; i++)
                acc[i * NTMAX + tk] += block_dot(q0[i], q1[i], qh[i], s[i], d[i], x, xs);
        }
    }
    [[unroll]] for (uint tk = 0; tk < NT; tk++)
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const float s = subgroupAdd(acc[i * NTMAX + tk]);
            if (gl_SubgroupInvocationID == 0) partial[(i * NTMAX + tk) * WG + gl_SubgroupID] = s;
        }
    barrier();
    const uint nr = min(NR, pc.nrows - r0);
    if (tid < nr * NT) {
        const uint i = tid / NT, tk = tid % NT;
        float s = 0.0;
        for (uint sg = 0; sg < gl_NumSubgroups; sg++) s += partial[(i * NTMAX + tk) * WG + sg];
        const uint yi = tk * pc.y_stride + r0 + i;
        Y[yi] = pc.accumulate != 0 ? Y[yi] + s : s;
    }
}
