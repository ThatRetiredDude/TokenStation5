// Gemma 4, per layer: G = gelu(G) * IN[off + i] over n values, G the
// per-layer gate's output and IN this layer's block of per-layer inputs
// (ple_prep.comp).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Gbuf { float G[]; };
layout(std430, binding = 1) readonly buffer Ibuf { float IN[]; };
layout(push_constant) uniform PC { uint n, off; } pc;

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) {
        const float g = G[i];
        const float y = 0.7978845608 * (g + 0.044715 * g * g * g);
        G[i] = 0.5 * g * (2.0 - 2.0 / (exp(2.0 * y) + 1.0)) * IN[pc.off + i];
    }
}
