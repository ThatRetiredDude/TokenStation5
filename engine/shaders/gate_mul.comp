// Qwen3.5's full-attention layers: each head's output times the sigmoid of
// its gate, A[t][h][d] *= sigmoid(QG[t][h][hd + d]) (see split_gate).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Abuf { float A[]; };
layout(std430, binding = 1) readonly buffer QGbuf { float QG[]; };
layout(push_constant) uniform PC { uint hd, n; } pc;  // n: tokens x heads x hd

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) {
        const uint head = i / pc.hd, d = i - head * pc.hd;
        A[i] *= 1.0 / (1.0 + exp(-QG[head * 2 * pc.hd + pc.hd + d]));
    }
}
