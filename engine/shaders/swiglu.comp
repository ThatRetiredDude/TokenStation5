// G = silu(G) * U, elementwise over n values.
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Gbuf { float G[]; };
layout(std430, binding = 1) readonly buffer Ubuf { float U[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) {
        float g = G[i];
        G[i] = g / (1.0 + exp(-g)) * U[i];
    }
}
