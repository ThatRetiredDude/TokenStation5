// G = silu(G) * U, elementwise over n values; with gelu, G = gelu(G) * U
// (Gemma's, the tanh approximation).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Gbuf { float G[]; };
layout(std430, binding = 1) readonly buffer Ubuf { float U[]; };
layout(push_constant) uniform PC { uint n, gelu; } pc;

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) {
        float g = G[i];
        if (pc.gelu != 0) {
            // tanh(y) as 1 - 2 / (exp(2y) + 1), which saturates instead of
            // overflowing for large |y|.
            const float y = 0.7978845608 * (g + 0.044715 * g * g * g);
            G[i] = 0.5 * g * (2.0 - 2.0 / (exp(2.0 * y) + 1.0)) * U[i];
        } else {
            G[i] = g / (1.0 + exp(-g)) * U[i];
        }
    }
}
