// X[off .. off + n) = 0 (the linear layers' state, when a call starts over
// at position 0).
#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Xbuf { float X[]; };
layout(push_constant) uniform PC { uint off, n; } pc;

void main() {
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += gl_NumWorkGroups.x * 256) X[pc.off + i] = 0.0;
}
