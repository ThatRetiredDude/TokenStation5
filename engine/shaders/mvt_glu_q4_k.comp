#version 450
// Y[t][r] = silu(G[r] . X[t]) * (U[r] . X[t]) for NT tokens of the
// feed-forward's Q4_K gate (binding 0) and up (binding 3) matrices at once:
// a verify batch through what mv16_glu_q4_k is for one token. Laid out as
// mvt_q4_k, but each block's words are loaded from both matrices and dotted
// with the same x values, so the x traffic — the dominant stream once the
// batch shares the weights — is paid once for the two biggest lines of a
// verify pass, and the swiglu kernel and its barrier are spared.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

#define WG 64
#define NTMAX 8
#define NRMAX 4
layout(local_size_x = WG) in;
layout(constant_id = 0) const uint NT = 2;  // tokens, at most NTMAX
layout(constant_id = 1) const uint NR = 1;  // rows per workgroup, at most NRMAX

layout(std430, binding = 0) readonly buffer W128 { uvec4 w128[]; };  // gate
layout(std430, binding = 1) readonly buffer Xbuf { vec4 X4[]; };
layout(std430, binding = 2) buffer Ybuf { float Y[]; };
layout(std430, binding = 3) readonly buffer U128 { uvec4 u128[]; };  // up

layout(push_constant) uniform PC {
    uint ncols, nrows, ntok, row_bytes;
    uint x_stride, y_stride, accumulate, x_off;
} pc;

shared float partial[NRMAX * NTMAX * WG];  // [row][token][subgroup]

// As mv16_q4_k: sub-blocks 2p and 2p + 1's 6-bit scales (bytes 0 and 1) and
// mins (bytes 2 and 3), from the block's header h.
uint scales_mins(uvec4 h, uint p) {
    const uint sh = 16u * (p & 1u);
    const uint a = (h.y >> sh) & 0xFFFFu, b = (h.z >> sh) & 0xFFFFu, c = (h.w >> sh) & 0xFFFFu;
    if (p < 2) return (a & 0x3F3Fu) | ((b & 0x3F3Fu) << 16);
    return ((c & 0x0F0Fu) | ((a >> 2) & 0x3030u)) | ((((c >> 4) & 0x0F0Fu) | ((b >> 2) & 0x3030u)) << 16);
}
vec4 bytes4(uint w) { return vec4(float(w & 255u), float((w >> 8) & 255u), float((w >> 16) & 255u), float(w >> 24)); }

// A block's header h and nibble word q (thread th of 8), with one token's x:
// a holds the low nibbles' 16 values, e the high ones', ta and te their sums.
float block_dot(uvec4 h, uvec4 q, vec4 a[4], vec4 e[4], float ta, float te, uint th) {
    float s0 = 0.0, s1 = 0.0;
    for (uint c = 0; c < 4; c++) {
        s0 += dot(bytes4(q[c] & 0x0F0F0F0Fu), a[c]);
        s1 += dot(bytes4((q[c] >> 4) & 0x0F0F0F0Fu), e[c]);
    }
    const vec4 sm = bytes4(scales_mins(h, th >> 1));  // scale 2p, 2p + 1, min 2p, 2p + 1
    const vec2 dm = unpackHalf2x16(h.x);
    return dm.x * (sm.x * s0 + sm.y * s1) - dm.y * (sm.z * ta + sm.w * te);
}

void main() {
    const uint r0 = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * NR;
    if (r0 >= pc.nrows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint nb = pc.ncols / 256, row_words = pc.row_bytes / 16;
    const uint th = tid % 8;
    float accg[NRMAX * NTMAX], accu[NRMAX * NTMAX];
    for (uint i = 0; i < NRMAX * NTMAX; i++) { accg[i] = 0.0; accu[i] = 0.0; }
    for (uint b = tid / 8; b < nb; b += WG / 8) {
        // Both matrices' header and nibble words for the NR rows, all in
        // flight at once. Rows past the matrix read its last row; their
        // sums aren't written.
        uvec4 hg[NRMAX], qg[NRMAX], hu[NRMAX], qu[NRMAX];
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const uint o = min(r0 + i, pc.nrows - 1) * row_words + b * 9;
            hg[i] = w128[o];
            qg[i] = w128[o + 1 + th];
            hu[i] = u128[o];
            qu[i] = u128[o + 1 + th];
        }
        const uint x0 = (b * 256) / 4 + 16 * (th >> 1) + 4 * (th & 1u);
        [[unroll]] for (uint t = 0; t < NT; t++) {
            const uint xt = (pc.x_off + t * pc.x_stride) / 4 + x0;
            vec4 a[4], e[4];
            float ta = 0.0, te = 0.0;
            [[unroll]] for (uint c = 0; c < 4; c++) {
                a[c] = X4[xt + c];
                e[c] = X4[xt + 8 + c];
                ta += a[c].x + a[c].y + a[c].z + a[c].w;
                te += e[c].x + e[c].y + e[c].z + e[c].w;
            }
            [[unroll]] for (uint i = 0; i < NR; i++) {
                accg[i * NTMAX + t] += block_dot(hg[i], qg[i], a, e, ta, te, th);
                accu[i * NTMAX + t] += block_dot(hu[i], qu[i], a, e, ta, te, th);
            }
        }
    }
    // The gate sums first, into the writer threads' g, then the same shared
    // words carry the up sums.
    [[unroll]] for (uint t = 0; t < NT; t++)
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const float s = subgroupAdd(accg[i * NTMAX + t]);
            if (gl_SubgroupInvocationID == 0) partial[(i * NTMAX + t) * WG + gl_SubgroupID] = s;
        }
    barrier();
    const uint nr = min(NR, pc.nrows - r0);
    float g = 0.0;
    if (tid < nr * NT) {
        const uint i = tid / NT, t = tid % NT;
        for (uint sg = 0; sg < gl_NumSubgroups; sg++) g += partial[(i * NTMAX + t) * WG + sg];
    }
    barrier();
    [[unroll]] for (uint t = 0; t < NT; t++)
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const float s = subgroupAdd(accu[i * NTMAX + t]);
            if (gl_SubgroupInvocationID == 0) partial[(i * NTMAX + t) * WG + gl_SubgroupID] = s;
        }
    barrier();
    if (tid < nr * NT) {
        const uint i = tid / NT, t = tid % NT;
        float u = 0.0;
        for (uint sg = 0; sg < gl_NumSubgroups; sg++) u += partial[(i * NTMAX + t) * WG + sg];
        Y[t * pc.y_stride + r0 + i] = g / (1.0 + exp(-g)) * u;
    }
}
