#version 450
// Y[t][r] = silu(G[r] . X[t]) * (U[r] . X[t]) (gelu for Gemma) for NT tokens of the
// feed-forward's Q4_K gate (binding 0) and up (binding 3) matrices at once:
// a verify batch through what mv16_glu_q4_k is for one token. Laid out as
// mvt_q4_k (the nibbles made floats and the scales and mins decoded once
// per row and block, before the token loop, the low nibbles first and the
// high ones after, each block summed in mv16_q4_k's order so that a verify
// batch agrees bit for bit with the one-token forward), but each block's
// words are loaded from both matrices
// and dotted with the same x values, so the x traffic is paid once for the
// two biggest lines of a verify pass, and the swiglu kernel and its
// barrier are spared. Holding two matrices' words doubles the register
// load: past NR = 2 the PS5 spilled with the earlier layout (1376 VGPRs
// into 36 KB of scratch at NR 4, NT 8 — a 7x regression, measured), so the
// backend caps this kernel's rows at 2.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_control_flow_attributes : require

#define WG 64
#define NTMAX 8
#define NRMAX 4
layout(local_size_x = WG) in;
layout(constant_id = 0) const uint NT = 2;  // tokens, at most NTMAX
layout(constant_id = 1) const uint NR = 1;  // rows per workgroup, at most NRMAX

layout(std430, binding = 0) readonly buffer W128 { uvec4 w128[]; };  // gate
layout(std430, binding = 1) readonly buffer Xbuf { vec4 X4[]; };
layout(std430, binding = 2) buffer Ybuf { float Y[]; };
layout(std430, binding = 3) readonly buffer U128 { uvec4 u128[]; };  // up

layout(push_constant) uniform PC {
    uint ncols, nrows, ntok, row_bytes;
    uint x_stride, y_stride, accumulate, x_off;
} pc;

shared float partial[NRMAX * NTMAX * WG];  // [row][token][subgroup]

// As mv16_q4_k: sub-blocks 2p and 2p + 1's 6-bit scales (bytes 0 and 1) and
// mins (bytes 2 and 3), from the block's header h.
uint scales_mins(uvec4 h, uint p) {
    const uint sh = 16u * (p & 1u);
    const uint a = (h.y >> sh) & 0xFFFFu, b = (h.z >> sh) & 0xFFFFu, c = (h.w >> sh) & 0xFFFFu;
    if (p < 2) return (a & 0x3F3Fu) | ((b & 0x3F3Fu) << 16);
    return ((c & 0x0F0Fu) | ((a >> 2) & 0x3030u)) | ((((c >> 4) & 0x0F0Fu) | ((b >> 2) & 0x3030u)) << 16);
}
vec4 bytes4(uint w) { return vec4(float(w & 255u), float((w >> 8) & 255u), float((w >> 16) & 255u), float(w >> 24)); }

// Thread th's two sub-blocks' scales and mins as floats: (s_lo, s_hi,
// m_lo, m_hi), as mv16_q4_k's block_dot decodes them.
vec4 scales(uvec4 h, uint th) { return bytes4(scales_mins(h, th >> 1)); }

// The thread's 16 low (hi == 0) or high nibbles of word q as floats.
void nibbles(uvec4 q, uint hi, out vec4 w[4]) {
    const uint sh = 4 * hi;
    [[unroll]] for (uint c = 0; c < 4; c++) w[c] = bytes4((q[c] >> sh) & 0x0F0F0F0Fu);
}

// The gate's activation times up: silu, or with pc.accumulate != 0 (unused
// otherwise with GLU) Gemma's gelu, the tanh approximation as swiglu.comp.
float glu_act(float g) {
    if (pc.accumulate != 0) {
        const float y = 0.7978845608 * (g + 0.044715 * g * g * g);
        return 0.5 * g * (2.0 - 2.0 / (exp(2.0 * y) + 1.0));
    }
    return g / (1.0 + exp(-g));
}

void main() {
    const uint r0 = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * NR;
    if (r0 >= pc.nrows) return;
    const uint tid = gl_LocalInvocationID.x;
    const uint nb = pc.ncols / 256, row_words = pc.row_bytes / 16;
    const uint th = tid % 8;
    float accg[NRMAX * NTMAX], accu[NRMAX * NTMAX];
    for (uint i = 0; i < NRMAX * NTMAX; i++) { accg[i] = 0.0; accu[i] = 0.0; }
    for (uint b = tid / 8; b < nb; b += WG / 8) {
        // Both matrices' header and nibble words for the NR rows, all in
        // flight at once. Rows past the matrix read its last row; their
        // sums aren't written.
        uvec4 hg[NRMAX], qg[NRMAX], hu[NRMAX], qu[NRMAX];
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const uint o = min(r0 + i, pc.nrows - 1) * row_words + b * 9;
            hg[i] = w128[o];
            qg[i] = w128[o + 1 + th];
            hu[i] = u128[o];
            qu[i] = u128[o + 1 + th];
        }
        vec4 smg[NRMAX], smu[NRMAX];
        vec2 dmg[NRMAX], dmu[NRMAX];
        [[unroll]] for (uint i = 0; i < NR; i++) {
            smg[i] = scales(hg[i], th);
            dmg[i] = unpackHalf2x16(hg[i].x);
            smu[i] = scales(hu[i], th);
            dmu[i] = unpackHalf2x16(hu[i].x);
        }
        const uint x0 = (b * 256) / 4 + 16 * (th >> 1) + 4 * (th & 1u);
        // The low nibbles against each token's first 16 x values: the sums
        // s0 and ta of mv16_q4_k's block_dot, held until the high half.
        float s0g[NRMAX * NTMAX], s0u[NRMAX * NTMAX], ta[NTMAX];
        {
            vec4 wg[NRMAX][4], wu[NRMAX][4];
            [[unroll]] for (uint i = 0; i < NR; i++) {
                nibbles(qg[i], 0, wg[i]);
                nibbles(qu[i], 0, wu[i]);
            }
            [[unroll]] for (uint t = 0; t < NT; t++) {
                const uint xt = (pc.x_off + t * pc.x_stride) / 4 + x0;
                vec4 a[4];
                float xs = 0.0;
                [[unroll]] for (uint c = 0; c < 4; c++) {
                    a[c] = X4[xt + c];
                    xs += a[c].x + a[c].y + a[c].z + a[c].w;
                }
                ta[t] = xs;
                [[unroll]] for (uint i = 0; i < NR; i++) {
                    float sg = 0.0, su = 0.0;
                    [[unroll]] for (uint c = 0; c < 4; c++) {
                        sg += dot(wg[i][c], a[c]);
                        su += dot(wu[i][c], a[c]);
                    }
                    s0g[i * NTMAX + t] = sg;
                    s0u[i * NTMAX + t] = su;
                }
            }
        }
        // The high nibbles against the other 16, then each block's sum into
        // its row, in block_dot's order.
        {
            vec4 wg[NRMAX][4], wu[NRMAX][4];
            [[unroll]] for (uint i = 0; i < NR; i++) {
                nibbles(qg[i], 1, wg[i]);
                nibbles(qu[i], 1, wu[i]);
            }
            [[unroll]] for (uint t = 0; t < NT; t++) {
                const uint xt = (pc.x_off + t * pc.x_stride) / 4 + x0 + 8;
                vec4 e[4];
                float te = 0.0;
                [[unroll]] for (uint c = 0; c < 4; c++) {
                    e[c] = X4[xt + c];
                    te += e[c].x + e[c].y + e[c].z + e[c].w;
                }
                [[unroll]] for (uint i = 0; i < NR; i++) {
                    float sg = 0.0, su = 0.0;
                    [[unroll]] for (uint c = 0; c < 4; c++) {
                        sg += dot(wg[i][c], e[c]);
                        su += dot(wu[i][c], e[c]);
                    }
                    accg[i * NTMAX + t] += dmg[i].x * (smg[i].x * s0g[i * NTMAX + t] + smg[i].y * sg) - dmg[i].y * (smg[i].z * ta[t] + smg[i].w * te);
                    accu[i * NTMAX + t] += dmu[i].x * (smu[i].x * s0u[i * NTMAX + t] + smu[i].y * su) - dmu[i].y * (smu[i].z * ta[t] + smu[i].w * te);
                }
            }
        }
    }
    // The gate sums first, into the writer threads' g, then the same shared
    // words carry the up sums.
    [[unroll]] for (uint t = 0; t < NT; t++)
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const float s = subgroupAdd(accg[i * NTMAX + t]);
            if (gl_SubgroupInvocationID == 0) partial[(i * NTMAX + t) * WG + gl_SubgroupID] = s;
        }
    barrier();
    const uint nr = min(NR, pc.nrows - r0);
    float g = 0.0;
    if (tid < nr * NT) {
        const uint i = tid / NT, t = tid % NT;
        for (uint sg = 0; sg < gl_NumSubgroups; sg++) g += partial[(i * NTMAX + t) * WG + sg];
    }
    barrier();
    [[unroll]] for (uint t = 0; t < NT; t++)
        [[unroll]] for (uint i = 0; i < NR; i++) {
            const float s = subgroupAdd(accu[i * NTMAX + t]);
            if (gl_SubgroupInvocationID == 0) partial[(i * NTMAX + t) * WG + gl_SubgroupID] = s;
        }
    barrier();
    if (tid < nr * NT) {
        const uint i = tid / NT, t = tid % NT;
        float u = 0.0;
        for (uint sg = 0; sg < gl_NumSubgroups; sg++) u += partial[(i * NTMAX + t) * WG + sg];
        Y[t * pc.y_stride + r0 + i] = glu_act(g) * u;
    }
}
