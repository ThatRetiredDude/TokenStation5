#version 450
// Y[t][r] (+)= the sum of mmb's n_split partial results for token t, row r
// (P from p_off: [slice][token][row]).
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Pbuf { float P[]; };
layout(std430, binding = 1) buffer Ybuf { float Y[]; };

layout(push_constant) uniform PC {
    uint nrows, ntok, y_stride, accumulate, n_split, p_off;
} pc;

void main() {
    const uint n = pc.nrows * pc.ntok;
    const uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256;
    if (i >= n) return;
    float s = 0.0;
    for (uint k = 0; k < pc.n_split; k++) s += P[pc.p_off + k * n + i];
    const uint yi = (i / pc.nrows) * pc.y_stride + i % pc.nrows;
    Y[yi] = pc.accumulate != 0 ? Y[yi] + s : s;
}
