# TokenStation settings, read by tokenstation.service.
# After changing them: sudo systemctl restart tokenstation

# The model to serve. Empty: the first .gguf in MODELS_DIR, by name.
MODEL=
MODELS_DIR=/var/lib/tokenstation/models

# Where the API listens. 0.0.0.0 = every network on this machine.
HOST=0.0.0.0
PORT=8081

# The API keys other machines get in with. Make them on ts5-tui's Access
# page (F6) or with: ts5 keys --file /var/lib/tokenstation/access/keys.tsv new NAME
# Until "require" is on (the Access page, or: ts5 keys --file ... require on)
# every machine that reaches the port gets in without one.
KEYS=/var/lib/tokenstation/access/keys.tsv

# The encyclopedia a search goes to when there is no web search key
# (TAVILY_API_KEY): wikipedia, grokipedia or both.
#TS5_ENCYCLOPEDIA=wikipedia

# Context length in tokens, or "auto" for what fits in GPU memory.
CONTEXT=8192

# PS5 only, with ps5_control from ps5-linux-tools: the fan on, and the clock
# boost off (0) or on (1). Off is faster for models: the kernel then runs the
# GPU at its full 2.23 GHz, where the boost's power management holds it
# lower. 1 is the console's game clocks (CPU 3.5 GHz), cooler and about 8%
# slower on prompts. If ps5-linux-tools' ps5boost.service is on, it turns
# the boost on at every boot before this takes effect.
PS5_BOOST=0
# Where ps5_control lives, if it is not on the PATH.
PS5_CONTROL=
# PS5 only: the fan curve, reapplied at every boot (the kernel's fan driver
# starts at its stock curve each time). auto = the stock curve; cool = the
# same curve steepened to full speed from a 65 C board reading; early = an
# aggressive curve that ramps from a 40 C reading and is at full speed by
# 55 C, for a box that runs long prompts back to back and wants the fan well
# ahead of the die; max = full speed always. Default auto. "early" trades
# noise for headroom under the kernel's 85 C clock limiter.
PS5_FAN=auto

# Anything else to pass to "ts5 serve".
EXTRA_ARGS=
