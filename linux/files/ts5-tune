# The answers' context: the app's "as much as fits" leaves a helper its room
# (its weights and 4k of context) and a 14B at ts5's own 8192 doesn't, so
# the helper is judged where it fits, as the app runs it.
CONTEXT = 4096
MAIN_MIN = 1536 << 20  # --models without names: files this big or bigger
HELPER_MIN = int(os.environ.get("TS5_TUNE_HELPER_MIN", 64 << 20))  # as the app's pick (the tests' models are smaller)


def data_dir():
    base = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return os.path.join(base, "tokenstation")


def tune_file():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "tokenstation", "tune.env")


def pick_model():
    models = glob.glob(os.path.join(data_dir(), "models", "**", "*.gguf"), recursive=True)
    models = [m for m in models if "mmproj" not in os.path.basename(m).lower()]
    if not models:
        sys.exit("ts5-tune: no models in %s; get one in TokenStation5 first, "
                 "or name one: ts5-tune MODEL.gguf" % os.path.join(data_dir(), "models"))
    return max(models, key=os.path.getatime)


def ts5():
    here = os.path.dirname(os.path.realpath(__file__))
    for p in (os.path.join(here, "ts5"), "/usr/bin/ts5"):
        if os.access(p, os.X_OK):
            return p
    return "ts5"


def bench(model, env, pp, tg):
    """(prompt tok/s, generation tok/s), or None if the run failed."""
    full = dict(os.environ)
    full["TS5_TUNE_FILE"] = ""  # measure from the defaults, not the old file
    for k, v in env.items():
        if v == "":
            full.pop(k, None)
        else:
            full[k] = v
    try:
        out = subprocess.run([ts5(), "bench", "-m", model, "--pp", str(pp), "--tg", str(tg)],
                             env=full, capture_output=True, text=True, errors="replace", timeout=900)
    except subprocess.TimeoutExpired:
        return None
    m = re.search(r"\|\s*([\d.]+)\s*\|\s*([\d.]+)\s*\|\s*$", out.stdout, re.M)
    if out.returncode != 0 or not m:
        return None
    return float(m.group(1)), float(m.group(2))


def runs_of(model, env, pp, tg, runs):
    return [r for r in (bench(model, env, pp, tg) for _ in range(runs)) if r]


def best_of(model, env, pp, tg, runs):
    results = runs_of(model, env, pp, tg, runs)
    if not results:
        return None
    return max(r[0] for r in results), max(r[1] for r in results)


def spread(results):
    """How far apart the same settings' runs came out (0.03 = 3%)."""
    worst = 0.0
    for i in (0, 1):
        v = [r[i] for r in results]
        if min(v) > 0:
            worst = max(worst, max(v) / min(v) - 1)
    return worst


def score(r, kind):
    if kind == "gen":
        return r[1]
    if kind == "prompt":
        return r[0]
    return (r[0] * r[1]) ** 0.5


def check(model, env, n=None, text=None):
    full = dict(os.environ)
    full["TS5_TUNE_FILE"] = ""
    for k, v in env.items():
        if v == "":
            full.pop(k, None)
        else:
            full[k] = v
    cmd = [ts5(), "check", "-m", model] + (["-n", str(n)] if n else []) + (["-p", text] if text else [])
    # The lines on differing tokens print a token's own bytes, which can be
    # part of a character.
    out = subprocess.run(cmd, env=full, capture_output=True, text=True, errors="replace", timeout=3600)
    lines = out.stdout.strip().splitlines()
    # The check's own line, then any "top token differs at" lines.
    line = next((l for l in lines if not l.startswith("  ")), lines[-1] if lines else "")
    return out.returncode == 0, line


def model_tune_dir():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "tokenstation", "tune")


def write(model, prompt, env, n):
    """(text, generation tok/s, why the helper wasn't used or None), or None."""
    full = dict(os.environ)
    full["TS5_MODEL_TUNE"] = ""  # not the file this writes; tune.env's speed settings stay
    for k, v in env.items():
        if v == "":
            full.pop(k, None)
        else:
            full[k] = v
    try:
        # Bytes: an answer cut at the token limit can end inside a character.
        out = subprocess.run([ts5(), "run", "-m", model, "-c", str(CONTEXT), "--chat", "-p", prompt, "-n", str(n),
                              "--temp", "0"], env=full, capture_output=True, timeout=1800)
    except subprocess.TimeoutExpired:
        return None
    err = out.stderr.decode(errors="replace")
    m = re.search(r"gen (\d+) tok ([\d.]+) tok/s", err)
    if out.returncode != 0 or not m:
        return None
    refused = re.search(r"draft model not used: (.*)", err)
    return out.stdout, float(m.group(2)), refused.group(1) if refused else None


def helpers(model):
    """The files a helper may be: beside it, half its size or less, 64 MiB or more.

    Half, where the app's own pick takes a quarter: what's tried here is
    measured, so a larger helper only stays if it's faster (Llama 3.2 1B
    makes Llama 3.2 3B 11-15% faster on the PS5 at 40% of its size)."""
    size = os.path.getsize(model)
    found = []
    for f in glob.glob(os.path.join(os.path.dirname(os.path.abspath(model)), "*.gguf")):
        if os.path.samefile(f, model) or "mmproj" in os.path.basename(f).lower():
            continue
        s = os.path.getsize(f)
        if s * 2 <= size and s >= HELPER_MIN:
            found.append((s, f))
    return can_draft(model, [f for _, f in sorted(found)])


def can_draft(model, files):
    """The files of `files` the engine would take as this model's helper.

    A helper has to share the model's vocabulary (a Qwen model's helper is
    a Qwen), which `ts5 helpers` tells from the files' headers in a second,
    so nothing is loaded and measured that could never help. An older ts5
    without `helpers` keeps them all, and each is found out at its load."""
    if not files:
        return files
    cmd = [ts5(), "helpers", "-m", model]
    for f in files:
        cmd += ["--helper", f]
    try:
        out = subprocess.run(cmd, capture_output=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired):
        return files
    if out.returncode != 0:
        return files
    verdict = {}
    for line in out.stdout.decode(errors="replace").splitlines():
        part = line.split("\t")
        if len(part) >= 2:
            verdict[part[1]] = (part[0] == "ok", part[2] if len(part) > 2 else "")
    kept, said = [], set()
    for f in files:
        ok, why = verdict.get(f, (True, ""))
        if ok:
            kept.append(f)
            continue
        # In plain words (ts5-tui shows these lines as they are).
        if "linear layers" in why and os.path.basename(model) in why:
            line = "  This kind of model can't use a helper (it can't take a wrong guess back)."
        elif "vocabulary" in why:
            line = "  %s is from another model family, so it can't be its helper." % os.path.basename(f)
        else:
            line = "  %s can't be its helper: %s" % (os.path.basename(f), why)
        if line not in said:
            print(line)
        said.add(line)
    return kept


# TS5_TUNE_PROGRESS=1 (ts5-tui sets it): a line per step for a progress
# panel, "@ts5-tune " and a JSON object, beside the usual lines:
#   {"event": "plan", "model": NAME, "steps": [{"label": ..., "answers": N}, ...]}
#   {"event": "step", "step": I, "state": "run"|"done"|"skip"|"fail", "result": TEXT}
#   {"event": "answer", "step": I, "n": K, "of": N}   (K answers of N written)
#   {"event": "detail", "step": I, "text": TEXT}
#   {"event": "summary", "text": TEXT}
PROGRESS = os.environ.get("TS5_TUNE_PROGRESS") == "1"


def progress(**kw):
    if PROGRESS:
        print("@ts5-tune " + json.dumps(kw), flush=True)


def mean(v):
    p = 1.0
    for x in v:
        p *= x
    return p ** (1.0 / len(v))


def tune_model(model, n):
    """Checks one model, finds its helper and drafts, and saves them; False if the model fails the check."""
    name = os.path.basename(model)
    print("\n== %s (%.1f GiB)" % (name, os.path.getsize(model) / (1 << 30)))
    chosen, notes = {}, []
    cands = helpers(model)  # only the files that could be its helper
    # The steps, for TS5_TUNE_PROGRESS: the check, the answers alone, each
    # helper at each drafts, saving.
    steps = [{"label": "Checking the model gives correct answers (a few minutes the first time)", "answers": 0},
             {"label": "Measuring its speed on its own (%d test answers)" % len(PROMPTS), "answers": len(PROMPTS)}]
    for h in cands:
        short = os.path.basename(h)[:-5] if h.lower().endswith(".gguf") else os.path.basename(h)
        for d in DRAFTS:
            steps.append({"label": "Trying the helper model %s, guessing %s words ahead"
                                   % (short, d), "answers": len(PROMPTS)})
    steps.append({"label": "Saving the best settings", "answers": 0})
    progress(event="plan", model=name, steps=steps)
    SAVE = len(steps) - 1
    progress(event="step", step=0, state="run")
    # 128 tokens: a full block, so every matrix takes the prompt kernel
    # whose math is 16-bit on Qwen, DeepSeek and Llama models.
    # Where that fails, 256 tokens of English decide (see CHECK_TEXT).
    def passes(env, what):
        if what:
            progress(event="detail", step=0, text="checking again with exact (32-bit) math for prompts")
        ok, line = check(model, env, 128)
        print("  check%s: %s" % (what, line))
        if ok:
            return True
        progress(event="detail", step=0, text="checking again on a paragraph of English")
        ok, line = check(model, env, 256, CHECK_TEXT)
        print("  check%s on English text: %s" % (what, line))
        if ok:
            notes.append("the check on its built-in tokens was over the bar%s and on English text it passed" % what)
        return ok

    if not passes({}, ""):
        if not passes({"TS5_MMB_F16": "0"}, " with 32-bit prompt math"):
            print("  %s fails the check either way, so it isn't tuned. Please report it, with the lines above." % name)
            progress(event="step", step=0, state="fail", result="its answers on this GPU aren't right")
            progress(event="summary", text="It isn't tuned: its answers on this GPU don't match the CPU's, even with "
                                           "the exact math. It keeps the settings it had. Please report it, with the "
                                           "lines below.")
            return False
        chosen["TS5_MMB_F16"] = "0"
        notes.append("16-bit prompt math failed the check and 32-bit passed")
        progress(event="step", step=0, state="done", result="correct, with exact math for prompts")
    else:
        progress(event="step", step=0, state="done", result="correct")
    alone = []
    progress(event="step", step=1, state="run")
    for p in PROMPTS:
        r = write(model, p, dict(chosen, TS5_DRAFT_MODEL="off"), n)
        if not r:
            print("  `ts5 run` failed on this model; is TokenStation5 still open?")
            progress(event="step", step=1, state="fail", result="it didn't run")
            progress(event="summary", text="It isn't tuned: the test answers didn't run. If TokenStation5 or its "
                                           "service still holds the GPU, close or stop it and tune again. It keeps "
                                           "the settings it had.")
            return False
        alone.append(r)
        progress(event="answer", step=1, n=len(alone), of=len(PROMPTS))
    base = mean([r[1] for r in alone])
    print("  alone: %s tok/s" % ", ".join("%.1f" % r[1] for r in alone))
    progress(event="step", step=1, state="done", result="%.1f tok/s" % base)
    best, best_env = base, None
    tried, refusals = 0, []
    step = 1
    for h in cands:
        refused = None
        for d in DRAFTS:
            step += 1
            if refused:
                progress(event="step", step=step, state="skip", result="can't help: " + refused)
                continue
            progress(event="step", step=step, state="run")
            env = dict(chosen, TS5_DRAFT_MODEL=h, TS5_DRAFT=d)
            runs = []
            for p in PROMPTS:
                r = write(model, p, env, n)
                if r is None:
                    break
                refused = r[2]  # the engine says so at load, so after the first prompt
                if refused:
                    break
                runs.append(r)
                progress(event="answer", step=step, n=len(runs), of=len(PROMPTS))
            if refused:
                print("  %s: not used: %s" % (os.path.basename(h), refused))
                refusals.append("%s: %s" % (os.path.basename(h), refused))
                progress(event="step", step=step, state="skip", result="can't help: " + refused)
                continue
            if len(runs) < len(PROMPTS):
                print("  %s, %s drafts: a run failed, skipped" % (os.path.basename(h), d))
                progress(event="step", step=step, state="fail", result="it didn't run")
                continue
            if any(r[0] != a[0] for r, a in zip(runs, alone)):
                # The engine keeps a draft only where the model writes the
                # same token, so this is a bug, not a slow helper.
                print("  %s, %s drafts: the answers differ from the model's own, so it isn't used. "
                      "Please report it." % (os.path.basename(h), d))
                progress(event="step", step=step, state="fail", result="its answers came out different, so it's not used")
                continue
            tried += 1
            sc = mean([r[1] for r in runs])
            print("  %s, %s drafts: %s tok/s (%+.0f%%)" % (os.path.basename(h), d,
                                                         ", ".join("%.1f" % r[1] for r in runs), (sc / base - 1) * 100))
            progress(event="step", step=step, state="done", result="%.1f tok/s, %s" % (
                sc, "%.0f%% faster" % ((sc / base - 1) * 100) if sc >= base else "%.0f%% slower" % ((1 - sc / base) * 100)))
            if sc > best * (1 + NOISE):
                best, best_env = sc, (h, d)
    if best_env:
        chosen["TS5_DRAFT_MODEL"] = os.path.basename(best_env[0])
        chosen["TS5_DRAFT"] = best_env[1]
        notes.append("helper %s at %s drafts a step: %.1f tok/s against %.1f alone (%+.0f%%), the same text"
                     % (os.path.basename(best_env[0]), best_env[1], best, base, (best / base - 1) * 100))
    elif tried:
        chosen["TS5_DRAFT_MODEL"] = "off"
        notes.append("no helper was faster than the model alone (%.1f tok/s)" % base)
    elif refusals:
        # None measured: the app's own pick stays (it finds none either, or
        # a memory refusal here may not hold in the app's context).
        notes.append("no helper could be measured (%s); %.1f tok/s alone" % ("; ".join(refusals), base))
    else:
        notes.append("no helper beside it (%.1f tok/s alone)" % base)
    os.makedirs(model_tune_dir(), exist_ok=True)
    path = os.path.join(model_tune_dir(), name + ".env")
    with open(path, "w") as f:
        f.write("# Written by ts5-tune --models on %s for %s.\n" % (time.strftime("%Y-%m-%d"), name))
        for note in notes:
            f.write("# %s%s.\n" % (note[0].upper(), note[1:]))
        f.write("# A setting chosen in the app or the shell wins. Delete this file to go back.\n")
        f.write("size=%d\n" % os.path.getsize(model))
        for k, v in chosen.items():
            f.write("%s=%s\n" % (k, v))
    print("  -> %s" % (" ".join("%s=%s" % kv for kv in chosen.items()) or "the defaults"))
    print("  saved to %s" % path)
    progress(event="step", step=SAVE, state="done", result="saved; used from the next time it loads")
    if best_env:
        summary = "It writes %.0f%% faster with the helper %s: %.1f tok/s, up from %.1f on its own, with the same answers." % (
            (best / base - 1) * 100, os.path.basename(best_env[0])[:-5], best, base)
    elif tried:
        summary = "No helper made it faster, so it runs on its own: %.1f tok/s." % base
    else:
        summary = "%.1f tok/s on its own: %s." % (base, "no helper here could run beside it" if refusals else "there's no smaller helper model beside it to try")
    if chosen.get("TS5_MMB_F16") == "0":
        summary += " It reads prompts with exact math, because the faster math wasn't accurate enough for it."
    progress(event="summary", text=summary)
    return True


def models_main(names, reset, n):
    if names:
        models = names
    else:
        models = sorted(f for f in glob.glob(os.path.join(data_dir(), "models", "**", "*.gguf"), recursive=True)
                        if "mmproj" not in os.path.basename(f).lower() and os.path.getsize(f) >= MAIN_MIN)
        if not models:
            sys.exit("ts5-tune: no models of 1.5 GiB or more in %s; name one: ts5-tune --models MODEL.gguf"
                     % os.path.join(data_dir(), "models"))
    if reset:
        for m in models:
            path = os.path.join(model_tune_dir(), os.path.basename(m) + ".env")
            try:
                os.remove(path)
                print("ts5-tune: removed %s" % path)
            except FileNotFoundError:
                pass
        return
    print("ts5-tune: %d model(s): %s" % (len(models), ", ".join(os.path.basename(m) for m in models)))
    print("ts5-tune: keep TokenStation5 closed until this finishes.")
    failed = []
    for m in models:
        try:
            ok = tune_model(m, n)
        except Exception as e:  # one model's failure doesn't stop the others
            print("  ts5-tune: %s: %s: %s" % (os.path.basename(m), type(e).__name__, e))
            ok = False
        if not ok:
            failed.append(m)
    if failed:
        sys.exit("\nts5-tune: not tuned: %s" % ", ".join(os.path.basename(m) for m in failed))
    print("\nts5-tune: done. TokenStation5 uses these from the next time it loads each model.")


def save(chosen, model, before, after):
    path = tune_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("# Written by ts5-tune on %s with %s.\n" % (time.strftime("%Y-%m-%d"), os.path.basename(model)))
        f.write("# Built-in settings: prompt %.1f tok/s, generation %.1f tok/s.\n" % before)
        f.write("# These settings:    prompt %.1f tok/s, generation %.1f tok/s.\n" % after)
        f.write("# Delete this file (or run ts5-tune --reset) to go back.\n")
        for k, v in chosen.items():
            f.write("%s=%s\n" % (k, v))
    return path


def main():
    ap = argparse.ArgumentParser(description="Find TokenStation5's fastest GPU settings on this machine.")
    ap.add_argument("model", nargs="*", help="a .gguf model (default: the one you used last; --models: each "
                    "one of 1.5 GiB or more in the models folder)")
    ap.add_argument("--reset", action="store_true", help="delete the saved settings")
    ap.add_argument("--models", action="store_true", help="each model's own settings: prompt math and helper")
    ap.add_argument("--tokens", type=int, default=256, help="--models: tokens per answer (256)")
    ap.add_argument("--pp", type=int, default=512, help="prompt tokens per bench (512)")
    ap.add_argument("--tg", type=int, default=64, help="generated tokens per bench (64)")
    ap.add_argument("--quick", action="store_true", help="one run per choice instead of two")
    a = ap.parse_args()

    if a.models:
        models_main(a.model, a.reset, a.tokens)
        return
    if len(a.model) > 1:
        ap.error("one model at a time, or --models")
    a.model = a.model[0] if a.model else None
    if a.reset:
        try:
            os.remove(tune_file())
            print("ts5-tune: removed %s; the built-in settings are back." % tune_file())
        except FileNotFoundError:
            print("ts5-tune: nothing to reset.")
        return
    model = a.model or pick_model()
    runs = 1 if a.quick else 2
    n = sum(len(v) - 1 for _, v in GEN + PROMPT + BOTH)
    print("ts5-tune: %s, %d choices to try, %d run(s) each." % (os.path.basename(model), n, runs))
    print("ts5-tune: keep TokenStation5 closed until this finishes.\n")

    chosen = {}
    first = runs_of(model, chosen, a.pp, a.tg, 3)
    if not first:
        sys.exit("ts5-tune: `ts5 bench -m %s` failed with the built-in settings. "
                 "Is TokenStation5 still open?" % model)
    base = max(r[0] for r in first), max(r[1] for r in first)
    # A change has to beat the noise: twice how far apart the same
    # settings' runs land, and at least 2%.
    noise = max(NOISE, 2 * spread(first))
    print("built-in settings: prompt %.1f tok/s, generation %.1f tok/s (runs within %.1f%%; "
          "a change must be %.1f%% faster)" % (base + (spread(first) * 100, noise * 100)))
    before, cur = base, base

    for kind, knobs in (("both", BOTH), ("gen", GEN), ("prompt", PROMPT)):
        for name, values in knobs:
            best_v, best_r = None, cur
            for v in values[1:]:
                trial = dict(chosen)
                trial[name] = v
                r = best_of(model, trial, a.pp, a.tg, runs)
                shown = v or "(unset)"
                if not r:
                    print("  %s=%s: failed, skipped" % (name, shown))
                    continue
                gain = score(r, kind) / score(best_r, kind) - 1
                print("  %s=%s: prompt %.1f, generation %.1f (%+.1f%%)" % (name, shown, r[0], r[1], gain * 100))
                if gain > noise:
                    best_v, best_r = v, r
            if best_v is not None:
                chosen[name] = best_v
                cur = best_r
                print("  -> keeping %s=%s" % (name, best_v or "(unset)"))

    if not chosen:
        print("\nts5-tune: the built-in settings are already the fastest here; nothing saved.")
        try:
            os.remove(tune_file())
        except FileNotFoundError:
            pass
        return
    print("\nts5-tune: checking the output is still right with %s ..." % " ".join(
        "%s=%s" % kv for kv in chosen.items()))
    ok, line = check(model, chosen)
    print("  " + line)
    if not ok and "RADV_PERFTEST" in chosen:
        del chosen["RADV_PERFTEST"]
        print("ts5-tune: trying again without RADV_PERFTEST ...")
        ok, line = check(model, chosen)
        print("  " + line)
    if ok:
        cur = best_of(model, chosen, a.pp, a.tg, runs + 1) or cur
    if not ok:
        sys.exit("ts5-tune: the check failed with these settings, so nothing was saved. "
                 "Please report it, with the lines above.")
    path = save(chosen, model, before, cur)
    print("\nts5-tune: prompt %.1f -> %.1f tok/s, generation %.1f -> %.1f tok/s." % (
        before[0], cur[0], before[1], cur[1]))
    print("ts5-tune: saved to %s. TokenStation5 uses it from its next start." % path)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\nts5-tune: stopped; nothing saved.")
