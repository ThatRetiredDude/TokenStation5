#!/usr/bin/env python3
"""Finds TokenStation5's fastest GPU settings on this machine.

    ts5-tune                 # the model you used last (from your models folder)
    ts5-tune MODEL.gguf      # a model of your choice
    ts5-tune --reset         # back to the built-in settings
    ts5-tune --models [MODEL.gguf ...]   # each model's own settings (below)

The engine's kernel choices were tuned on the PS5's own driver. Under Linux
the same GPU runs RADV (Mesa), whose compiler and scheduling differ, so the
best choices can too. ts5-tune runs `ts5 bench` with each choice, one at a
time, keeps what is faster by more than the noise, checks the result is
still correct (`ts5 check`), and saves the winners to
~/.config/tokenstation/tune.env. TokenStation5 and ts5 read that file at
start-up; delete it (or run --reset) to go back.

Close TokenStation5 first: the bench needs the GPU's memory. It takes about
10 minutes for an 8B model.

--models tunes what differs from model to model, for each model named or
each one of 1.5 GiB and more in the models folder: it checks the model
against the CPU (`ts5 check -n 128`, and on 256 tokens of English text where
that fails) and keeps 32-bit prompt math if 16-bit fails where 32-bit
passes; then it writes four prompts' answers, at a
4,096-token context (where a 14B has room for a helper), alone and with each
helper model beside it (half its size or less, and one the engine accepts)
at 3 and at 5 drafts a step, keeps the fastest whose answers are the very
text the model writes alone, and turns the helper off when none it could
measure is faster. The results go to ~/.config/tokenstation/tune/<model
file>.env, which the app and ts5 read when they load that file (a setting
chosen in the app or the shell still wins); delete it, or run --models
--reset, to go back. It takes about 10 minutes for an 8B model and 15-20 for
a 14B (on the PS5).
"""
import argparse
import glob
import json
import os
import re
import subprocess
import sys
import time

# (variable, values to try). The first value is the engine's default.
# Generation (tokens out) and prompt (tokens in) settings are scored on
# their own speed; the rest on both. Settings that change the arithmetic
# (TS5_MMB_F16) or leave the Vulkan spec (TS5_BARRIER=2) are not tried.
GEN = [
    ("TS5_MV_ROWS", ["4", "2", "8", "1"]),
    ("TS5_MV16", ["1", "0"]),
    ("TS5_MV_ROWS_MIN", ["1024", "0", "2048", "4096"]),
    ("TS5_ATTN_DEC_PLAIN", ["-1", "1", "0"]),
    ("TS5_ATTN_DEC_KEYS", ["16", "8", "32"]),
    ("TS5_AHEAD", ["1", "0"]),
    ("TS5_DEC_SUBMIT", ["0", "8"]),
]
PROMPT = [
    ("TS5_MMB", ["1", "0"]),
    ("TS5_MMB_SMALL", ["1", "0"]),
    ("TS5_MMB_SPLIT", ["128", "256", "512"]),  # the built-in is 128 on RADV
    ("TS5_ATTN_PF128", ["1", "0"]),
    ("TS5_LAYERS_PER_SUBMIT", ["0", "8"]),
]
BOTH = [
    ("RADV_PERFTEST", ["cswave32", "nocswave32"]),
    ("TS5_FUSE", ["1", "0"]),
    ("TS5_NORM_FUSE", ["0", "1"]),
    ("TS5_BARRIER", ["1", "0"]),
]
NOISE = 0.02  # a change has to be 2% faster to count

# --models: prompts for the helper's speed and same-text test, two of
# prose and two of code (a helper guesses code better, so both count).
PROMPTS = [
    "Explain in a few paragraphs how a refrigerator keeps food cold, for someone who never thought about it.",
    "Write a short, friendly email inviting the neighbours to a garden barbecue on Saturday afternoon.",
    "Write a Python function that splits one CSV line with quoted fields (commas inside quotes, doubled "
    "quotes) into a list of strings, and a few tests for it.",
    "Write a C function that reverses a singly linked list in place, and a main() that builds a list, "
    "reverses it and prints it.",
]
DRAFTS = ["3", "5"]  # drafts a step to try; the engine's default is 5
# --models: plain English for a check on real text, where the check on its
# built-in tokens fails. Those are arbitrary tokens, where one near-tie can
# land a single position just over the bar (Gemma 3 12B: 0.52% at one of 128
# in 32-bit too, while 512 tokens of English pass at 0.05%).
CHECK_TEXT = (
    "Bread is one of the oldest foods people make, and the way it is made has changed less than you might think. "
    "Flour, water, salt and something to make it rise are still the whole of it. The flour is ground from wheat, "
