[Unit]
Description=TokenStation local AI endpoint
After=network-online.target
Wants=network-online.target
# A model that fails to load is tried 5 times, then left off (systemctl
# status says why), instead of restarting every 5 s for good.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=-/etc/default/tokenstation
# Runs as root ("+"): PS5 clock boost and fan, skipped on other machines.
ExecStartPre=+/usr/lib/tokenstation/boost.sh
ExecStart=/usr/lib/tokenstation/start.sh
User=tokenstation
Group=tokenstation
# GPU access comes from the render and video groups (postinst adds them).
WorkingDirectory=/var/lib/tokenstation
# /run/tokenstation: the owner's ts5-tui puts its control socket here (the
# phone's controls, /ts5/control); its group (tokenstation) may write in it.
# Kept over a restart, which every model load through Settings is.
RuntimeDirectory=tokenstation
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
