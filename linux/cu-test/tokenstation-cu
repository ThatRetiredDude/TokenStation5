#!/bin/sh
# tokenstation-cu: see and choose how many GPU compute units a PS5 running
# Linux uses, and test whether this chip gets the extra ones right.
#
#   tokenstation-cu status        active CUs now, and the boot setting
#   tokenstation-cu set 36|38|40  boot setting (takes effect after a reboot)
#   tokenstation-cu probe         next boot only logs which GPU sections have
#                                 disabled CUs, without turning them on
#   tokenstation-cu test [SECS]   GPU self-test (and ts5 check if a model is
#                                 installed); run it once at 36 first
#
# Sony ships 36 of the chip's 40 CUs on; on some chips one of the extra pairs
# is faulty. The kernel option is amdgpu.ps5_cu_unlock from the ps5-linux
# kernel: 0 = off (36), 2 = first GPU section only (38 if that section has a
# disabled pair, else 36), 3 = all (40), 4 = probe. CUs come on in pairs.
# Nothing here changes the setting by itself: you decide.
#
# If a setting won't boot, edit cmdline.txt on the boot drive's FAT32
# partition from another computer and set amdgpu.ps5_cu_unlock=0.
set -eu

# Root's own folder (0700): the service user owns /var/lib/tokenstation, and
# root writes the logs and baselines here.
state=/var/lib/tokenstation-cu
selftest=${GPU_SELFTEST:-/usr/lib/tokenstation/gpu-selftest}

find_cmdline() {
    if [ -n "${CMDLINE:-}" ]; then echo "$CMDLINE"; return; fi
    for f in /boot/efi/cmdline.txt /efi/cmdline.txt /boot/firmware/cmdline.txt /boot/cmdline.txt; do
        [ -f "$f" ] && { echo "$f"; return; }
    done
    echo "tokenstation-cu: can't find cmdline.txt; set CMDLINE=/path/to/cmdline.txt" >&2
    exit 2
}

# From the kernel's boot messages: dmesg's ring buffer, or, once that has
# rotated them out (hours of uptime), the journal of this boot.
active_cus() {
    n=$(dmesg 2>/dev/null | grep -o 'active_cu_number[^0-9]*[0-9]*' | tail -n 1 | grep -o '[0-9]*$' || true)
    [ -n "$n" ] || n=$(journalctl -k -b 2>/dev/null | grep -o 'active_cu_number[^0-9]*[0-9]*' | tail -n 1 | grep -o '[0-9]*$' || true)
    echo "${n:-unknown}"
}

boot_mode() {
    grep -o 'amdgpu\.ps5_cu_unlock=[0-9]*' "$(find_cmdline)" 2>/dev/null | head -n 1 | cut -d= -f2 || true
}

# cmdline.txt, rewritten so a power cut leaves the old one or the new one,
# never half of one: the old one to .bak, the new one to a file beside it,
# both flushed to the drive, then renamed over it.
write_cmdline() {  # file line
    cp "$1" "$1.bak"
    sync "$1.bak" 2>/dev/null || sync
    printf '%s\n' "$2" > "$1.new"
    sync "$1.new" 2>/dev/null || sync
    mv -f "$1.new" "$1"
    sync "$(dirname "$1")" 2>/dev/null || sync
}

# ts5 on a model from the service's folder, as the service's user: the file
# is that user's, so root doesn't read it.
as_service() {
    if [ "$(id -u)" = 0 ] && getent passwd tokenstation >/dev/null; then
        if command -v runuser >/dev/null; then
            runuser -u tokenstation -- "$@"
        else
            setpriv --reuid=tokenstation --regid=tokenstation --init-groups -- "$@"
        fi
    else
        "$@"
    fi
}

# The self-test, shown and saved in $log, with its own exit status (a plain
# "| tee" would give tee's, and a failed or missing self-test would PASS).
selftest_logged() {
    st=0
    { "$selftest" "$@" 2>&1 || echo "$?" > "$state/selftest.rc"; } | tee "$log"
    [ -f "$state/selftest.rc" ] && { st=$(cat "$state/selftest.rc"); rm -f "$state/selftest.rc"; }
    return "$st"
}

set_mode() {  # mode
    f=$(find_cmdline)
    [ "$(id -u)" = 0 ] || { echo "tokenstation-cu: run with sudo" >&2; exit 2; }
    line=$(head -n 1 "$f" | tr -d '\r' | sed 's/[[:space:]]*amdgpu\.ps5_cu_unlock=[0-9]*//g')
    if [ "$1" = 0 ]; then write_cmdline "$f" "$line"; else write_cmdline "$f" "$line amdgpu.ps5_cu_unlock=$1"; fi
    echo "boot setting saved in $f (old one in $f.bak). Reboot and run the loader again for it to take effect."
}

case "${1:-status}" in
status)
    m=$(boot_mode)
    case "${m:-0}" in
        0) want="36 (stock)";;
        2) want="38 (first GPU section; 36 if that section has no disabled pair)";;
        3) want="40 (all)";;
        1|4) want="probe only (36, logs the disabled sections)";;
        *) want="unknown mode $m";;
    esac
    echo "active compute units now: $(active_cus)"
    echo "boot setting:             $want"
    lines=$(dmesg 2>/dev/null | grep -E 'ps5-[0-9]+cu-(enable|probe)' || true)
    [ -n "$lines" ] || lines=$(journalctl -k -b -o cat 2>/dev/null | grep -E 'ps5-[0-9]+cu-(enable|probe)' || true)
    [ -z "$lines" ] || echo "$lines" | sed 's/^/  /'
    ;;
set)
    case "${2:-}" in
        36) set_mode 0;;
        38) set_mode 2;;
        40) set_mode 3;;
        *) echo "usage: tokenstation-cu set 36|38|40" >&2; exit 2;;
    esac
    ;;
probe)
    set_mode 4
    echo "after the reboot, 'tokenstation-cu status' lists which sections have disabled CUs."
    ;;
test)
    secs=${2:-120}
    if [ "$(id -u)" = 0 ]; then
        [ -L "$state" ] && { echo "tokenstation-cu: $state is a symlink; not using it" >&2; exit 2; }
        install -d -o root -g root -m 700 "$state"
    else
        state=$(mktemp -d "${TMPDIR:-/tmp}/tokenstation-cu.XXXXXX")
    fi
    cus=$(active_cus)
    log=$state/test-$cus-$(date +%Y%m%d-%H%M%S).log
    echo "testing with $cus active compute units for $secs s; log: $log"
    since=$(date '+%Y-%m-%d %H:%M:%S')
    rc=0
    rm -f "$state/selftest.rc"
    if [ "$cus" = 36 ] || [ ! -f "$state/baseline.txt" ]; then
        [ "$cus" = 36 ] || echo "no baseline from a 36 CU run yet; this run only checks itself"
        selftest_logged --seconds "$secs" --save "$state/baseline-$cus.txt" || rc=$?
        if [ "$cus" = 36 ] && [ "$rc" = 0 ]; then cp "$state/baseline-$cus.txt" "$state/baseline.txt"; fi
    else
        selftest_logged --seconds "$secs" --compare "$state/baseline.txt" || rc=$?
    fi
    model=$(find /var/lib/tokenstation/models -maxdepth 1 -name '*.gguf' 2>/dev/null | LC_ALL=C sort | head -n 1)
    if [ -n "$model" ] && command -v ts5 >/dev/null; then
        echo "ts5 check on $(basename "$model") (GPU against a CPU reference)" | tee -a "$log"
        if as_service ts5 check -m "$model" -n 64 > "$state/check.out" 2>&1; then :; else rc=1; fi
        cat "$state/check.out" >> "$log"
        tail -n 3 "$state/check.out"
        as_service ts5 bench -m "$model" --pp 512 --tg 128 2>&1 | tee -a "$log" | tail -n 2 || true
    fi
    gpu_errors=$(journalctl -k --since "$since" 2>/dev/null | grep -Eci 'amdgpu.*\b(timeout|reset|fault|hang)' || true)  # \b: "default" (TMZ ... disabled as experimental (default)) isn't a fault
    echo "GPU errors in the kernel log during the test: ${gpu_errors:-0}" | tee -a "$log"
    [ "${gpu_errors:-0}" = 0 ] || rc=1
    if [ "$rc" = 0 ]; then
        echo "verdict: PASS with $cus compute units" | tee -a "$log"
    else
        echo "verdict: FAIL with $cus compute units. 'sudo tokenstation-cu set 36' (or 38) and reboot." | tee -a "$log"
    fi
    exit "$rc"
    ;;
*)
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
