#!/bin/sh
set -e
if [ "$1" = configure ]; then
    if ! getent passwd tokenstation >/dev/null; then
        adduser --system --group --home /var/lib/tokenstation --no-create-home tokenstation
    fi
    # The rest is what the .rpm and Arch packages do too (system-setup):
    # a fresh install, an upgrade, or an upgrade from a .deb older than 0.1,
    # whose prerm stopped both services.
    if [ -z "${2:-}" ]; then
        how=install
    elif dpkg --compare-versions "$2" lt 0.1~; then
        how=restart
    else
        how=upgrade
    fi
    /usr/lib/tokenstation/system-setup configure "$how"
fi
exit 0
